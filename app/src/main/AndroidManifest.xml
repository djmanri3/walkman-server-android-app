<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Acceso a Internet para cargar la web y reproducir streaming -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Mantener la reproducción en segundo plano -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Control de audio por hardware (bluetooth, auriculares, teclado) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Estado de la red para recargar / detectar conectividad -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notificaciones -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Walkman"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Walkman">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Actions: expone actions.intent.PLAY_MEDIA / GET_THING a
                 Google Assistant / Gemini para búsquedas por voz -->
            <meta-data
                android:name="android.app.actions.assistant"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Búsqueda por voz del Asistente: actividad sin interfaz que recibe
             las órdenes y reenvía la consulta a MainActivity para reproducirla -->
        <activity
            android:name=".VoiceSearchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Diálogo de selección de color de acento (abierto desde el logo del widget) -->
        <activity
            android:name=".AccentColorActivity"
            android:exported="true"
            android:theme="@style/Theme.Walkman.Dialog"
            android:excludeFromRecents="true" />

        <!-- Android Auto: permite que el sistema de infoentretenimiento conecte -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Servicio multimedia: mantiene la MediaSession y la notificación -->
        <service
            android:name=".MediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Receptor de botones multimedia (bluetooth / auriculares / teclado) -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Widget de pantalla de inicio para controlar la reproducción -->
        <receiver
            android:name=".WalkmanWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.djmanri3.Walkman.action.WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/walkman_widget_info" />
        </receiver>

    </application>

</manifest>
